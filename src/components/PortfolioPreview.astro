---
import { Image } from 'astro:assets';
import Placeholder from '@assets/portfolio/portfolio-placeholder.jpg';
import { getPortfolio, pieceHref } from '@utils/portfolio';

// Only pieces marked `featured: true` in their front matter, newest first.
const featured = (await getPortfolio()).filter((p) => p.data.featured);
---

{
  featured.length > 0 && (
    <div class="info-viewport img-only portfolio-preview">
      <div class="viewport-overlay" />
      <div
        class="swiper portfolio-preview-swiper animate__animated animate__fadeIn"
        role="region"
        aria-roledescription="carousel"
        aria-label="Featured portfolio pieces"
        data-count={featured.length}
      >
        <ul class="swiper-wrapper">
          {featured.map((piece, i) => (
            <li class="swiper-slide" data-piece={piece.id} data-position={i + 1}>
              <a href={pieceHref(piece)} aria-label={`View ${piece.data.title}`}>
                <Image
                  class="art-img"
                  src={piece.data.heroImage ?? Placeholder}
                  alt={piece.data.heroAlt ?? `${piece.data.title} preview`}
                  title={piece.data.title}
                  width={800}
                  height={600}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 840px) 100vw, 800px"
                  fit="cover"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<script>
  import Swiper from 'swiper';
  import { Autoplay, EffectFade, A11y, Keyboard } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-fade';
  import { respectReducedMotion } from '@utils/swiper-motion';
  import { track } from '@utils/track';

  const el = document.querySelector<HTMLElement>('.portfolio-preview-swiper');
  const count = Number(el?.dataset.count ?? 0);

  // One featured piece: nothing to rotate, so it stays a plain linked image.
  if (el && count > 1) {
    const root = document.documentElement;
    const swiper = new Swiper(el, {
      modules: [Autoplay, EffectFade, A11y, Keyboard],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      speed: 750,
      loop: true,
      keyboard: { enabled: true },
      a11y: { slideRole: 'listitem' },
      autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
    });

    respectReducedMotion(swiper);

    // Which featured pieces actually get looked at: a slide counts once it has been on screen
    // for 1.5s while the carousel is in view. One event per piece per visit.
    const seen = new Set<string>();
    let visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const consider = () => {
      clearTimeout(timer);
      const slide = swiper.slides[swiper.activeIndex] as HTMLElement | undefined;
      const piece = slide?.dataset.piece;
      if (!visible || !piece || seen.has(piece)) return;
      timer = setTimeout(() => {
        seen.add(piece);
        track('portfolio-preview-seen', { piece, position: Number(slide?.dataset.position ?? 0), of: count });
      }, 1500);
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      consider();
    }, { threshold: 0.5 }).observe(el);
    swiper.on('slideChangeTransitionEnd', consider);
    document.addEventListener('visibilitychange', () => (document.visibilityState === 'hidden' ? clearTimeout(timer) : consider()));
  }
</script>

<style>
  .portfolio-preview-swiper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 3em;
  }
  .swiper-wrapper {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .swiper-slide,
  .swiper-slide a {
    display: block;
    height: 100%;
  }
  .swiper-slide a:hover {
    cursor: pointer;
  }
  .swiper-slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
