---
import '../assets/fontawesome/css/all.min.css';
import 'animate.css';
import '../styles/theme.scss';

import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/background.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = FallbackImage,
  imageAlt = `${SITE_TITLE} portfolio website`,
  noindex = false,
  type = 'website'
} = Astro.props;

const site = Astro.site;

if (!site) {
  throw new Error('Set the site URL in astro.config.mjs');
}

const isHomepage = Astro.url.pathname.replace(/\/+$/, '') === '';
const pageTitle = isHomepage ? SITE_TITLE : `${title} • ${SITE_TITLE}`;
const canonicalURL = new URL(
  Astro.url.pathname,
  site
);
const imageURL = new URL(image.src, site);
---

<!-- Basic metadata -->
<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1"
/>
<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Robots -->
<meta name="robots" content={[
    noindex ? 'noindex' : 'index',
    'follow',
    'noai',
    'noimageai'
  ].join(', ')}
/>

<!-- Canonical -->
<link rel="canonical" href={canonicalURL.href} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<!-- Sitemap -->
<link
  rel="sitemap"
  type="application/xml"
  href="/sitemap-index.xml"
/>

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('/rss.xml', site).href}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_CA" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL.href} />

<!-- Fonts -->
<Font cssVariable="--font-spinnaker" preload />
<Font cssVariable="--font-fuzzy-bubbles" />