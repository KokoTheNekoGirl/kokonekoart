---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

// Words that map to .btn-<variant> in _btn.scss; any other class passes through as-is.
const VARIANTS = ['primary', 'secondary', 'cta', 'comms', 'total', 'portfolio', 'icon', 'locked'];

const {
    href,
    class: className,
    rel,
    ...props
} = Astro.props;

const tokens = (typeof className === 'string' ? className : '').split(/\s+/).filter(Boolean);
const classes = tokens.map((t) => (VARIANTS.includes(t) ? `btn-${t}` : t));
const isPrimary = tokens.includes('primary');

const relTokens = new Set(rel?.split(/\s+/).filter(Boolean));
const isExternal = relTokens.has('external');
if (isExternal) relTokens.add('noopener');
const relValue = relTokens.size ? [...relTokens].join(' ') : undefined;
---

<a href={href} role="button" class:list={['btn', classes]} {...props} rel={relValue} aria-describedby={isExternal ? 'external-hint' : undefined} target={isExternal ? '_blank' : undefined} itemprop="url">
    {isPrimary && <span class="whiskers-left"></span>}
    <span class="btn-text" itemprop="name"><slot /></span>
    {isPrimary && <span class="whiskers-right"></span>}
</a>