# Security headers for every page. Replaces the "headers" block that lived in vercel.json.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://www.paypal.com")
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://www.paypal.com https://*.paypalobjects.com https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://*.paypal.com https://*.paypalobjects.com https://cloud.umami.is; font-src 'self' data:; media-src 'self'; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://api-gateway.umami.dev https://www.paypal.com https://*.paypal.com https://www.google.com; worker-src 'self' blob:; frame-src https://www.google.com https://www.paypal.com https://*.paypal.com

# Legacy demo pages need third-party scripts, fonts and widgets, so they get their own, looser policy.
# `!` removes the strict policy from the rule above before this one is added.
/project/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://kit.fontawesome.com https://cdnjs.cloudflare.com https://unpkg.com https://storage.ko-fi.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com https://cdnjs.cloudflare.com https://use.typekit.net https://p.typekit.net https://ka-f.fontawesome.com https://storage.ko-fi.com; font-src 'self' data: https://fonts.gstatic.com https://use.typekit.net https://ka-f.fontawesome.com https://storage.ko-fi.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://ka-f.fontawesome.com https://ko-fi.com; frame-src https://www.google.com https://ko-fi.com https://www.youtube.com https://open.spotify.com
